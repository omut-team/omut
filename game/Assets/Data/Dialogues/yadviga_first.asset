  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f27f95ecd8929d54c9a4fb6612ca4e56, type: 3}
  m_Name: yadviga_first
  m_EditorClassIdentifier: Omut::Omut.NPC.DialogueData
  id: yadviga_first
  lines:
  - speaker: "\u041F\u0430\u043D\u0438 \u042F\u0434\u0432\u0438\u0433\u0430"
    text: "\u041E\u0439, \u0431\u043E\u0436\u0430, \u0442\u044B \u0436 \u0432\u043D\u0443\u043A
      \u042F\u0437\u044D\u043F\u0430! \u0413\u043B\u0430\u0437\u0430 \u0442\u0435
      \u0436\u0435."
  - speaker: "\u0421\u044B\u043C\u043E\u043D"
    text: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435.
      \u0410 \u0432\u044B?"
  - speaker: "\u041F\u0430\u043D\u0438 \u042F\u0434\u0432\u0438\u0433\u0430"
    text: "\u042F\u0434\u0432\u0438\u0433\u0430, \u0441\u043E\u0441\u0435\u0434\u043A\u0430.
      \u041C\u044B \u0441 \u0442\u0432\u043E\u0438\u043C \u0434\u0435\u0434\u043E\u043C
      \u0441\u043E\u0440\u043E\u043A \u043B\u0435\u0442 \u0447\u0435\u0440\u0435\u0437
      \u0437\u0430\u0431\u043E\u0440 \u0437\u0434\u043E\u0440\u043E\u0432\u0430\u043B\u0438\u0441\u044C."
  - speaker: "\u041F\u0430\u043D\u0438 \u042F\u0434\u0432\u0438\u0433\u0430"
    text: "\u041E\u043D \u0432\u0441\u0451 \u043F\u0438\u0441\u0430\u043B \u0432
      \u0442\u0435\u0442\u0440\u0430\u0434\u043A\u0443 \u0438 \u043F\u0440\u044F\u0442\u0430\u043B
      \u043B\u0438\u0441\u0442\u044B \u0432 \u0441\u0443\u043D\u0434\u0443\u0447\u043A\u0438.
      \u0413\u043E\u0432\u043E\u0440\u0438\u043B, \u043E\u0437\u0435\u0440\u043E
      \u0438\u0445 \u0441\u0431\u0435\u0440\u0435\u0436\u0451\u0442."
  - speaker: "\u041F\u0430\u043D\u0438 \u042F\u0434\u0432\u0438\u0433\u0430"
    text: "\u041D\u043E\u0447\u044C\u044E \u0431\u0435\u0437 \u0444\u043E\u043D\u0430\u0440\u044F
      \u043D\u0435 \u043F\u043B\u0430\u0432\u0430\u0439. \u0421\u0442\u0430\u043D\u0435\u0442
      \u0441\u0442\u0440\u0430\u0448\u043D\u043E, \u043F\u0435\u0439 \u0447\u0430\u0439.
      \u0422\u0430\u0440\u0430\u0441 \u043F\u0440\u043E\u0434\u0430\u0451\u0442,
      \u0445\u043E\u0442\u044C \u0438 \u0434\u043E\u0440\u043E\u0433\u043E."
