  m_Script: {fileID: 11500000, guid: f27f95ecd8929d54c9a4fb6612ca4e56, type: 3}
  m_Name: yazep_first
  m_EditorClassIdentifier: Omut::Omut.NPC.DialogueData
  id: yazep_first
  lines:
  - speaker: "\u042F\u0437\u044D\u043F"
    text: "\u0421\u044B\u043C\u043E\u043D... \u0412\u044B\u0440\u043E\u0441-\u0442\u043E
      \u043A\u0430\u043A."
  - speaker: "\u0421\u044B\u043C\u043E\u043D"
    text: "\u0414\u0435\u0434?! \u0422\u044B \u0436\u0438\u0432\u043E\u0439?"
  - speaker: "\u042F\u0437\u044D\u043F"
    text: "\u0425\u043E\u0437\u044F\u0438\u043D \u0434\u0435\u0440\u0436\u0430\u043B
      \u043C\u0435\u043D\u044F \u0432 \u0442\u0443\u043C\u0430\u043D\u0435 \u0442\u0440\u0438
      \u0433\u043E\u0434\u0430. \u0422\u044B \u0435\u0433\u043E \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u043B,
      \u0438 \u043C\u0435\u043D\u044F \u0432\u043C\u0435\u0441\u0442\u0435 \u0441
      \u043D\u0438\u043C."
  - speaker: "\u042F\u0437\u044D\u043F"
    text: "\u0412\u043E\u0437\u044C\u043C\u0438 \u043C\u043E\u044E \u0443\u0434\u043E\u0447\u043A\u0443,
      \u0438\u0437 \u043C\u043E\u0440\u0451\u043D\u043E\u0433\u043E \u0434\u0443\u0431\u0430.
      \u0422\u0435\u0431\u0435 \u043E\u043D\u0430 \u0442\u0435\u043F\u0435\u0440\u044C
      \u043D\u0443\u0436\u043D\u0435\u0435."
