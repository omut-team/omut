  m_Script: {fileID: 11500000, guid: f27f95ecd8929d54c9a4fb6612ca4e56, type: 3}
  m_Name: mikhalych_first
  m_EditorClassIdentifier: Omut::Omut.NPC.DialogueData
  id: mikhalych_first
  lines:
  - speaker: "\u041C\u0438\u0445\u0430\u043B\u044B\u0447"
    text: "\u041E, \u043D\u0430\u0441\u043B\u0435\u0434\u043D\u0438\u043A! \u0411\u0430\u0440\u043A\u0430\u0441
      \u042F\u0437\u044D\u043F\u0430 \u044F \u0441\u0442\u043E \u0440\u0430\u0437
      \u043B\u0430\u0442\u0430\u043B."
  - speaker: "\u041C\u0438\u0445\u0430\u043B\u044B\u0447"
    text: "\u0423\u0434\u0430\u0440\u0438\u0448\u044C\u0441\u044F \u043E \u043A\u043E\u0440\u044F\u0433\u0443
      \u0432 \u043E\u043C\u0443\u0442\u0435 \u0438\u043B\u0438 \u043E \u0441\u043A\u0430\u043B\u0443
      \u043D\u0430 \u0440\u0438\u0444\u0435, \u0442\u0430\u0449\u0438 \u0441\u044E\u0434\u0430.
      \u0427\u0438\u043D\u044E \u0437\u0430 \u043C\u043E\u043D\u0435\u0442\u044B
      \u0438 \u0436\u0435\u043B\u0435\u0437\u043E \u0441\u043E \u0434\u043D\u0430."
  - speaker: "\u041C\u0438\u0445\u0430\u043B\u044B\u0447"
    text: "\u0410 \u043D\u0430\u0434\u043E\u0435\u0441\u0442 \u043A\u043E\u0440\u044B\u0442\u043E,
      \u0435\u0441\u0442\u044C \u0443 \u043C\u0435\u043D\u044F \u043A\u0430\u0442\u0435\u0440\u0430:
      \xAB\u0421\u043B\u0435\u0434\u043E\u043F\u044B\u0442\xBB \u0438 \xAB\u041E\u0445\u043E\u0442\u043D\u0438\u043A
      \u0437\u0430 \u0442\u0435\u043D\u044F\u043C\u0438\xBB. \u041D\u0435\u0434\u0451\u0448\u0435\u0432\u043E,
      \u043D\u043E \u043E\u043D\u043E \u0442\u043E\u0433\u043E \u0441\u0442\u043E\u0438\u0442."
