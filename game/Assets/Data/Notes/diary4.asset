  title: "\u0421\u0442\u0440\u0430\u043D\u0438\u0446\u0430 4"
  text: "\u0425\u043E\u0437\u044F\u0438\u043D \u0441\u0442\u0430\u0440, \u043A\u0430\u043A
    \u044F. \u041E\u043D \u043D\u0435 \u0437\u043B\u043E\u0439, \u043E\u043D \u0431\u043E\u043B\u044C\u043D\u043E\u0439:
    \u0432 \u043D\u0451\u043C \u043A\u0440\u044E\u0447\u043A\u0438 \u0432\u0441\u0435\u0445,
    \u043A\u0442\u043E \u0435\u0433\u043E \u043B\u043E\u0432\u0438\u043B. \u042D\u0442\u043E
    \u043E\u043D \u0434\u0435\u0440\u0436\u0438\u0442 \u043C\u0443\u0442\u0430\u043D\u0442\u043E\u0432
    \u0443 \u0440\u0438\u0444\u0430 \u0438 \u043D\u0435 \u043F\u0443\u0441\u043A\u0430\u0435\u0442
    \u0438\u0445 \u0432 \u0437\u0430\u043B\u0438\u0432."
