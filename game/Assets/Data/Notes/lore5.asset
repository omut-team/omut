  order: 5
  title: "\u0425\u043E\u0437\u044F\u0438\u043D"
  text: "\u0412 \u043D\u043E\u0447\u044C, \u043A\u043E\u0433\u0434\u0430 \u042F\u0437\u044D\u043F
    \u043F\u0440\u043E\u043F\u0430\u043B, \u044F \u0432\u0438\u0434\u0435\u043B \u0441
    \u043C\u0430\u044F\u043A\u0430 \u0442\u0435\u043D\u044C \u043F\u043E\u0434 \u0432\u043E\u0434\u043E\u0439,
    \u0431\u043E\u043B\u044C\u0448\u0435 \u043B\u043E\u0434\u043A\u0438. \u0421\u0442\u0430\u0440\u0438\u043A\u0438
    \u0437\u043E\u0432\u0443\u0442 \u0435\u0451 \u0425\u043E\u0437\u044F\u0438\u043D\u043E\u043C
    \u041E\u043C\u0443\u0442\u0430. \u0415\u0441\u043B\u0438 \u043E\u043D \u0436\u0438\u0432,
    \u043E\u043D \u043F\u043E\u043C\u043D\u0438\u0442 \u0442\u0432\u043E\u0435\u0433\u043E
    \u0434\u0435\u0434\u0430."
