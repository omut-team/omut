  order: 2
  title: "\u041F\u0435\u0440\u0432\u044B\u0435 \u0443\u0440\u043E\u0434\u044B"
  text: "\u0427\u0435\u0440\u0435\u0437 \u0433\u043E\u0434 \u0432 \u0441\u0435\u0442\u044F\u0445
    \u043F\u043E\u0448\u043B\u0438 \u0440\u044B\u0431\u044B \u0441 \u0434\u0432\u0443\u043C\u044F
    \u0433\u043E\u043B\u043E\u0432\u0430\u043C\u0438. \u041F\u043E \u043D\u043E\u0447\u0430\u043C
    \u043E\u043D\u0438 \u0441\u0432\u0435\u0442\u0438\u043B\u0438\u0441\u044C. \u0412
    \u0437\u0430\u043F\u0438\u0441\u043A\u0430\u0445 \u0443\u0447\u0451\u043D\u044B\u0445
    \u0431\u044B\u043B\u043E \u043F\u0440\u043E \u043E\u043F\u044B\u0442\u044B, \u0430
    \u0441\u0442\u0430\u0440\u0438\u043A\u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438:
    \u044D\u0442\u043E \u0412\u0430\u0434\u0437\u044F\u043D\u0456\u043A \u0437\u043B\u0438\u0442\u0441\u044F."
