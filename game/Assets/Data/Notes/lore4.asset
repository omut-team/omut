  id: lore4
  kind: 0
  order: 4
  title: "\u042F\u0437\u044D\u043F"
  text: "\u0422\u0432\u043E\u0439 \u0434\u0435\u0434 \u043D\u0435 \u0432\u0435\u0440\u0438\u043B
    \u043D\u0438 \u0432 \u0412\u0430\u0434\u0437\u044F\u043D\u0456\u043A\u0430, \u043D\u0438
    \u0432 \u0443\u0447\u0451\u043D\u044B\u0445. \u0425\u043E\u0434\u0438\u043B \u043D\u043E\u0447\u044C\u044E
    \u043A \u0440\u0438\u0444\u0443, \u0438\u0441\u043A\u0430\u043B \u0447\u0442\u043E-\u0442\u043E
    \u043D\u0430 \u0434\u043D\u0435. \u0413\u043E\u0432\u043E\u0440\u0438\u043B,
    \u0447\u0442\u043E \u0441\u0442\u0430\u043D\u0446\u0438\u044E \u043D\u0430\u0434\u043E
    \u0437\u0430\u043A\u0440\u044B\u0442\u044C \u0434\u043E \u043A\u043E\u043D\u0446\u0430."
