  id: q4_night
  title: "\u041D\u043E\u0447\u043D\u043E\u0439 \u0443\u043B\u043E\u0432"
  giver: 0
  description: "\u041F\u043E\u0439\u043C\u0430\u0442\u044C 2 \u0440\u044B\u0431\u044B
    \u043D\u043E\u0447\u044C\u044E, \u043F\u043E\u0441\u043B\u0435 \u043A\u043E\u043B\u043E\u043A\u043E\u043B\u0430.
    \u0414\u0435\u0440\u0436\u0438\u0441\u044C \u0443 \u0441\u0432\u0435\u0442\u0430."
  goal: 2
  fishId: 
  count: 2
  rewardMoney: 50
  rewardBait: 2
  rewardBaitCount: 3
  rewardFlag: 
  requiredQuest: q2_pike
  giveText: "\u0425\u043E\u0447\u0435\u0448\u044C \u043F\u043E\u043D\u044F\u0442\u044C
    \u043E\u0437\u0435\u0440\u043E, \u0432\u044B\u0439\u0434\u0438 \u043D\u043E\u0447\u044C\u044E.
    \u0422\u043E\u043B\u044C\u043A\u043E \u0444\u043E\u043D\u0430\u0440\u044C \u043D\u0435
    \u0433\u0430\u0441\u0438 (F) \u0438 \u0434\u0435\u0440\u0436\u0438 \u0447\u0430\u0439
    \u043F\u043E\u0434 \u0440\u0443\u043A\u043E\u0439. \u041F\u043E\u0439\u043C\u0430\u0439
    \u0434\u0432\u0435 \u0440\u044B\u0431\u044B \u043F\u043E\u0441\u043B\u0435 \u043A\u043E\u043B\u043E\u043A\u043E\u043B\u0430."
  completeText: "\u0416\u0438\u0432\u043E\u0439 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F,
    \u0438 \u0441 \u0443\u043B\u043E\u0432\u043E\u043C. \u0412\u043E\u0442 \u0442\u0435\u0431\u0435
    \u0444\u043E\u0441\u0444\u043E\u0440\u043D\u044B\u0435 \u0431\u043B\u0451\u0441\u043D\u044B,
    \u043D\u0430 \u043D\u0438\u0445 \u043D\u043E\u0447\u043D\u044B\u0435 \u0443\u0440\u043E\u0434\u044B
    \u043A\u043B\u044E\u044E\u0442."
