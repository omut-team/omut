  id: q1_crucian
  title: "\u041F\u0435\u0440\u0432\u044B\u0439 \u0443\u043B\u043E\u0432"
  giver: 0
  description: "\u041F\u043E\u0439\u043C\u0430\u0442\u044C 3 \u043A\u0430\u0440\u0430\u0441\u0435\u0439
    \u0432 \u0437\u0430\u043B\u0438\u0432\u0435. \u0427\u0435\u0440\u0432\u044C,
    \u0434\u043D\u0451\u043C."
  goal: 0
  fishId: crucian
  count: 3
  rewardMoney: 40
  rewardBait: 1
  rewardBaitCount: 3
  rewardFlag: 
  requiredQuest: 
  giveText: "\u041D\u0430\u0447\u043D\u0438 \u0441 \u043F\u0440\u043E\u0441\u0442\u043E\u0433\u043E.
    \u0417\u0430\u043B\u0438\u0432 \u043A \u044E\u0433\u0443 \u043E\u0442 \u043F\u0440\u0438\u0447\u0430\u043B\u0430,
    \u0442\u0430\u043C \u043A\u0430\u0440\u0430\u0441\u044C \u043D\u0430 \u0447\u0435\u0440\u0432\u044F
    \u0431\u0435\u0440\u0451\u0442. \u041F\u043E\u0439\u043C\u0430\u0439 \u0442\u0440\u0451\u0445,
    \u0430 \u044F \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u044E, \u0431\u0443\u0434\u0435\u0442
    \u043B\u0438 \u0438\u0437 \u0442\u0435\u0431\u044F \u0440\u044B\u0431\u0430\u043A."
  completeText: "\u0422\u0440\u0438 \u043A\u0430\u0440\u0430\u0441\u044F! \u042F\u0437\u044D\u043F
    \u0431\u044B \u043E\u0434\u043E\u0431\u0440\u0438\u043B. \u0414\u0435\u0440\u0436\u0438
    \u043C\u043E\u043D\u0435\u0442\u044B \u0438 \u043F\u0430\u0440\u0443 \u0431\u043B\u0451\u0441\u0435\u043D,
    \u0432 \u043E\u043C\u0443\u0442\u0435 \u043F\u0440\u0438\u0433\u043E\u0434\u044F\u0442\u0441\u044F."
