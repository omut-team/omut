  giveText: "\u0411\u0430\u0440\u043A\u0430\u0441 \u0434\u043B\u044F \u0440\u0438\u0444\u0430
    \u0441\u043B\u0430\u0431\u043E\u0432\u0430\u0442. \u041D\u0430\u0431\u0435\u0440\u0451\u0448\u044C
    \u0442\u044B\u0441\u044F\u0447\u0443 \u043C\u043E\u043D\u0435\u0442, \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043C
    \u043F\u0440\u043E \xAB\u0421\u043B\u0435\u0434\u043E\u043F\u044B\u0442\u0430\xBB.
    \u0421\u043A\u0438\u043D\u0443 \u0442\u0435\u0431\u0435 \u043D\u0435\u043C\u043D\u043E\u0433\u043E."
  completeText: "\u0422\u044B\u0441\u044F\u0447\u0430! \u0422\u044B \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u044B\u0439
    \u0440\u044B\u0431\u0430\u043A. \u0414\u0435\u0440\u0436\u0438 \u043F\u0440\u0435\u043C\u0438\u044E,
    \u043D\u0430 \u043A\u0430\u0442\u0435\u0440 \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u0441\u044F."
