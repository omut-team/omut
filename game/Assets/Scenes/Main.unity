  id: 0
  displayName: "\u0422\u0430\u0440\u0430\u0441"
  portrait: {fileID: 21300000, guid: 48388d045300b844fa1c2321e6ed77f0, type: 3}
  firstMeeting: {fileID: 11400000, guid: 2d3a0801f90ee0f4680a29409d3dbacd, type: 2}
  greetings:
  - "\u041D\u0443 \u0447\u0442\u043E, \u043A\u043B\u044E\u0451\u0442?"
  - "\u041A\u043E\u043B\u043E\u043A\u043E\u043B \u0441\u0435\u0433\u043E\u0434\u043D\u044F
    \u0432 \u0432\u043E\u0441\u0435\u043C\u044C, \u043A\u0430\u043A \u0432\u0441\u0435\u0433\u0434\u0430."
  - "\u041E\u043F\u044F\u0442\u044C \u0442\u044B. \u041B\u0430\u0434\u043D\u043E,
    \u0433\u043E\u0432\u043E\u0440\u0438."
  - "\u041C\u0430\u044F\u043A \u0433\u043E\u0440\u0438\u0442, \u0437\u043D\u0430\u0447\u0438\u0442,
    \u0432\u0441\u0451 \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435."
