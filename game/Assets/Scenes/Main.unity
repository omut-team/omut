  m_Name: 
  m_EditorClassIdentifier: Omut::Omut.NPC.Yazep
  radius: 1.6
  id: 3
  displayName: "\u042F\u0437\u044D\u043F"
  portrait: {fileID: 21300000, guid: 2f45160ee38eb72418c048b3a7f52205, type: 3}
  firstMeeting: {fileID: 11400000, guid: 55eff3560ea3a9f489f58e4d020bc34f, type: 2}
  greetings:
  - "\u041E\u0437\u0435\u0440\u043E \u0441\u0442\u0430\u043B\u043E \u0442\u0438\u0448\u0435.
    \u0421\u043B\u044B\u0448\u0438\u0448\u044C?"
  - "\u0422\u0430\u0440\u0430\u0441 \u0432\u0441\u0451 \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u0438\u0442
    \u043C\u043D\u0435 \u0442\u0443 \u0449\u0443\u043A\u0443."
  - "\u041B\u043E\u0432\u0438, \u0432\u043D\u0443\u043A. \u0410 \u044F \u043F\u043E\u0441\u0438\u0436\u0443,
    \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u044E."
