  m_Script: {fileID: 11500000, guid: 93a955b439b950b41a3b4912c877643a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Omut::Omut.NPC.Npc
  radius: 1.6
  id: 2
  displayName: "\u041F\u0430\u043D\u0438 \u042F\u0434\u0432\u0438\u0433\u0430"
  portrait: {fileID: 21300000, guid: f9dec2945f6bdbd499a2cd41a35a4fe2, type: 3}
  firstMeeting: {fileID: 11400000, guid: 6364a8ed19c0c8243a4cda2d7ff2e481, type: 2}
  greetings:
  - "\u0427\u0430\u0439 \u043F\u0438\u043B \u0441\u0435\u0433\u043E\u0434\u043D\u044F?"
  - "\u0422\u0430\u0440\u0430\u0441 \u043E\u043F\u044F\u0442\u044C \u0432\u043E\u0440\u0447\u0438\u0442?
    \u041E\u043D \u0434\u043E\u0431\u0440\u044B\u0439, \u043F\u0440\u043E\u0441\u0442\u043E
    \u0441\u0442\u0430\u0440\u044B\u0439."
  - "\u042F\u0437\u044D\u043F \u043B\u044E\u0431\u0438\u043B \u0432\u0435\u0447\u0435\u0440\u043E\u043C
    \u0441\u0438\u0434\u0435\u0442\u044C \u043D\u0430 \u043C\u043E\u0441\u0442\u043A\u0430\u0445."
  - "\u0411\u0435\u0440\u0435\u0433\u0438 \u0441\u0435\u0431\u044F \u043D\u0430 \u0432\u043E\u0434\u0435,
    \u0434\u0435\u0442\u043A\u0430."
