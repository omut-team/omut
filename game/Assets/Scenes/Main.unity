  firstMeeting: {fileID: 11400000, guid: 6c5f96f38ed2e97479a7148be2562fd8, type: 2}
  greetings:
  - "\u041D\u0443 \u0447\u0442\u043E, \u043B\u043E\u0434\u043A\u0430 \u0446\u0435\u043B\u0430?"
  - "\u0416\u0435\u043B\u0435\u0437\u043E \u043F\u0440\u0438\u0432\u0451\u0437?"
  - "\u041C\u043E\u0442\u043E\u0440 \u0441\u043B\u044B\u0448\u0443 \u0438\u0437\u0434\u0430\u043B\u0435\u043A\u0430.
    \u0417\u0430\u0445\u043E\u0434\u0438."
